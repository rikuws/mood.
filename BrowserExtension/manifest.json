{
  "manifest_version": 3,
  "name": "mood.",
  "version": "0.1.0",
  "description": "Collect visual references from the web for your moodboard.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Save to mood."
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "content/x-content.css"
      ],
      "js": [
        "lib/capture-helpers.js",
        "content/x-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
